server {
    server_name flaisgranito.com www.flaisgranito.com;

    # Increase maximum allowed upload size (allows videos up to 500MB)
    client_max_body_size 500M;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types 
        text/plain 
        text/css 
        text/xml 
        text/javascript 
        application/javascript 
        application/x-javascript 
        application/xml 
        application/json 
        image/svg+xml;
    gzip_disable "MSIE [1-6]\.";

    # Frontend
    root /var/www/Flais-Granito/Flais-Frontend/dist;
    index index.html;

    # ==========================================
    # Caching with Fallback to Website Content
    # ==========================================
    location ~* \.(?:css|js)$ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
        try_files $uri $uri/ @backend_content;
    }

    location ~* \.(?:jpg|jpeg|gif|png|ico|svg|webp|woff|woff2|ttf|otf|mp4|webm|ogg|m4v)$ {
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, no-transform";
        access_log off;
        try_files $uri $uri/ @backend_content;
    }

    # ==========================================
    # Dynamic Routing (Frontend -> Backend Content -> React)
    # ==========================================
    location / {
        try_files $uri $uri/ @backend_content;
    }

    location @backend_content {
        root /sftp/360user;
        index index.html;
        try_files $uri $uri/ @react_router;
    }

    location @react_router {
        root /var/www/Flais-Granito/Flais-Frontend/dist;
        try_files /index.html =404;
    }

    # ==========================================
    # Admin Panel
    # ==========================================
    location ^~ /admin/ {
        alias /var/www/Flais-Granito/Flais-Admin/dist/;
        index index.html;
        try_files $uri $uri/ @admin;
    }

    location @admin {
        rewrite ^/admin/(.*)$ /admin/index.html last;
    }

    # ==========================================
    # Backend APIs & Media
    # ==========================================
    location ^~ /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /media/ {
        alias /var/www/Flais-Granito/Flais-Backend/uploads/;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, no-transform";
    }



    location /uploads/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ==========================================
    # SSL config (Managed by Certbot)
    # ==========================================
    listen 443 ssl; 
    ssl_certificate /etc/letsencrypt/live/flaisgranito.com/fullchain.pem;     
    ssl_certificate_key /etc/letsencrypt/live/flaisgranito.com/privkey.pem; 
    include /etc/letsencrypt/options-ssl-nginx.conf; 
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; 
}
