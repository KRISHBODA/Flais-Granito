PORT=8000
MONGO_URI=mongodb://localhost:27017/flais
# Generate a unique secret per environment, e.g. `openssl rand -hex 48`
JWT_SECRET=replace-me-with-a-long-random-secret
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500
STORAGE_ROOT=./uploads
STORAGE_BASE_URL=http://localhost:8000/media
MAX_UPLOAD_SIZE_BYTES=524288000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5175
# Optional: allow Vercel preview URLs for one project only, e.g. flais-frontend
VERCEL_PREVIEW_PREFIX=
# Required by `npm run seed:admin` (minimum 12 characters)
ADMIN_SEED_EMAIL=admin@flais.com
ADMIN_SEED_PASSWORD=
APP_STATUS=LIVE
